      "source": [
        "\n",
        "n = int(input(\"Enter odd number of rows: \"))\n",
        "for i in range(n):\n",
        "    for j in range(n):\n",
        "        if j == i or j == n - i - 1:\n",
        "            print(\"*\", end=\"\")\n",
        "        else:\n",
        "            print(\" \", end=\"\")\n",
        "    print()\n"
      ],
