      "source": [
        "n = int(input(\"Enter rows: \"))\n",
        "for i in range(1, n + 1):\n",
        "    print(\" \" * (n - i), end=\"\")\n",
        "    for j in range(1, 2 * i):\n",
        "        print(j, end=\"\")\n",
        "    print()\n",
        "\n"
      ],
