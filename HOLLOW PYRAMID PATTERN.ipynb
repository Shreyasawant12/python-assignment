      "source": [
        "n = int(input(\"Enter rows: \"))\n",
        "for i in range(1, n + 1):\n",
        "    for j in range(1, 2 * n):\n",
        "        if j == n - i + 1 or j == n + i - 1 or i == n:\n",
        "            print(\"*\", end=\"\")\n",
        "        else:\n",
        "            print(\" \", end=\"\")\n",
        "    print()"
      ],
