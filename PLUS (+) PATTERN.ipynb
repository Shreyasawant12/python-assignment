      "source": [
        "n = int(input(\"Enter odd number of rows: \"))\n",
        "mid = n // 2\n",
        "for i in range(n):\n",
        "    for j in range(n):\n",
        "        if i == mid or j == mid:\n",
        "            print(\"*\", end=\"\")\n",
        "        else:\n",
        "            print(\" \", end=\"\")\n",
        "    print()\n"
      ],
