        "\n",
        "n = int(input(\"Enter rows: \"))\n",
        "for i in range(n, 0, -1):\n",
        "    print(\" \" * (n - i), end=\"\")\n",
        "    for j in range(1, 2 * i):\n",
        "        print(j, end=\"\")\n",
        "    print()\n"
      ],
