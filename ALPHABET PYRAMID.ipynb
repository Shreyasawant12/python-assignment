      "source": [
        "\n",
        "n = int(input(\"Enter rows: \"))\n",
        "for i in range(1, n + 1):\n",
        "    print(\" \" * (n - i), end=\"\")\n",
        "    for j in range(2 * i - 1):\n",
        "        print(chr(65 + j), end=\"\")\n",
        "    print()\n"
      ],
