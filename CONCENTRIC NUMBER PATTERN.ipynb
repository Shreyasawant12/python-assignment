      "source": [
        "\n",
        "n = int(input(\"Enter outer number: \"))\n",
        "size = 2 * n - 1\n",
        "\n",
        "for i in range(size):\n",
        "    for j in range(size):\n",
        "        value = n - min(i, j, size - 1 - i, size - 1 - j)\n",
        "        print(value, end=\"\")\n",
        "    print()\n"
      ],
